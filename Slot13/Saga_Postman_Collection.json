        {
          "name": "[KB2] 3. Kiểm tra kho & ví (không đổi)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventoryUrl}}/api/inventory/products",
              "host": [
                "{{inventoryUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const expectStock = { \"P1\": 0 };",
                  "const expectBal = { \"C2\": 0 };",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.response.json().forEach(p => {",
                  "    if (p.id in expectStock) {",
                  "        const before = Number(pm.environment.get(\"stock_\" + p.id) || pm.collectionVariables.get(\"stock_\" + p.id));",
                  "        pm.test(`Tồn kho ${p.id} không đổi: ${before} -> ${p.stock}`, () => pm.expect(p.stock).to.eql(before));",
                  "    }",
                  "});",
                  "const payUrl = pm.environment.get(\"paymentUrl\") || pm.collectionVariables.get(\"paymentUrl\") || \"http://localhost:8083\";",
                  "pm.sendRequest(payUrl + \"/api/payments/wallets\", (err, res) => {",
                  "    if (res) res.json().forEach(w => {",
                  "        if (w.customerId in expectBal) {",
                  "            const before = Number(pm.environment.get(\"bal_\" + w.customerId) || pm.collectionVariables.get(\"bal_\" + w.customerId));",
                  "            pm.test(`Số dư ${w.customerId} không đổi: ${before} -> ${w.balance}`, () => pm.expect(w.balance).to.eql(before));",
                  "        }",
                  "    });",
                  "});",
                  "const invUrl = pm.environment.get(\"inventoryUrl\") || pm.collectionVariables.get(\"inventoryUrl\") || \"http://localhost:8082\";",
                  "pm.sendRequest(invUrl + \"/api/inventory/reservations\", (err, res) => {",
                  "    pm.test(\"Đọc được danh sách reservations\", () => pm.expect(err).to.be.null);",
                  "    const reservations = res ? res.json() : [];",
                  "    const targetId = pm.environment.get(\"kb2OrderId\") || pm.collectionVariables.get(\"kb2OrderId\");",
                  "    const kb2Res = Array.isArray(reservations) ? reservations.find(r => r.orderId == targetId) : undefined;",
                  "    pm.test(\"Reservation của KB2 đổi sang RELEASED\", () => {",
                  "        pm.expect(kb2Res, \"Reservation not found\").to.not.be.undefined;",
                  "        if (kb2Res) {",
                  "            pm.expect(kb2Res.status).to.eql(\"RELEASED\");",
                  "        }",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
