    {
      "name": "KB1 - Happy path",
      "item": [
        {
          "name": "[KB1] 1. Snapshot kho & ví",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventoryUrl}}/api/inventory/products",
              "host": [
                "{{inventoryUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.response.json().forEach(p => {",
                  "    pm.collectionVariables.set(\"stock_\" + p.id, p.stock);",
                  "    pm.environment.set(\"stock_\" + p.id, p.stock);",
                  "});",
                  "const payUrl = pm.environment.get(\"paymentUrl\") || pm.collectionVariables.get(\"paymentUrl\") || \"http://localhost:8083\";",
                  "pm.sendRequest(payUrl + \"/api/payments/wallets\", (err, res) => {",
                  "    pm.test(\"Đọc được số dư ví\", () => pm.expect(err).to.be.null);",
                  "    if (res) res.json().forEach(w => {",
                  "        pm.collectionVariables.set(\"bal_\" + w.customerId, w.balance);",
                  "        pm.environment.set(\"bal_\" + w.customerId, w.balance);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[KB1] 2. Đặt hàng (C1 mua 2 P1 giá 2000)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"C1\",\n  \"productId\": \"P1\",\n  \"quantity\": 2,\n  \"amount\": 2000.0\n}"
            },
            "url": {
              "raw": "{{orderUrl}}/api/orders",
              "host": [
                "{{orderUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const o = pm.response.json();",
                  "if (o && o.id) {",
                  "    pm.collectionVariables.set(\"kb1OrderId\", o.id);",
                  "    pm.environment.set(\"kb1OrderId\", o.id);",
                  "}",
                  "pm.test(\"Order status = CONFIRMED\", () => pm.expect(o.status).to.eql(\"CONFIRMED\"));",
                  "pm.test(\"Saga status = COMPLETED\", () => pm.expect(o.sagaStatus).to.eql(\"COMPLETED\"));",
                  "pm.test(\"Không có failureReason\", () => pm.expect(o.failureReason).to.be.null);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[KB1] 3. Kiểm tra kho & ví",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventoryUrl}}/api/inventory/products",
              "host": [
                "{{inventoryUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const expectStock = { \"P1\": -2 };",
                  "const expectBal = { \"C1\": -2000.0 };",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.response.json().forEach(p => {",
                  "    if (p.id in expectStock) {",
                  "        const before = Number(pm.collectionVariables.get(\"stock_\" + p.id));",
                  "        pm.test(`Tồn kho ${p.id}: ${before} -> ${before + expectStock[p.id]}`,",
                  "            () => pm.expect(p.stock).to.eql(before + expectStock[p.id]));",
                  "    }",
                  "});",
                  "pm.sendRequest(pm.collectionVariables.get(\"paymentUrl\") + \"/api/payments/wallets\", (err, res) => {",
                  "    res.json().forEach(w => {",
                  "        if (w.customerId in expectBal) {",
                  "            const before = Number(pm.collectionVariables.get(\"bal_\" + w.customerId));",
                  "            pm.test(`Số dư ${w.customerId}: ${before} -> ${before + expectBal[w.customerId]}`,",
                  "                () => pm.expect(w.balance).to.eql(before + expectBal[w.customerId]));",
                  "        }",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[KB1] 4. Saga logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderUrl}}/api/orders/{{kb1OrderId}}/saga-logs",
              "host": [
                "{{orderUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{kb1OrderId}}",
                "saga-logs"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const steps = pm.response.json().map(l => l.step);",
                  "pm.test(\"Thứ tự bước Saga đúng: CREATE_ORDER -> RESERVE_INVENTORY -> PROCESS_PAYMENT -> CONFIRM_ORDER\", () => pm.expect(steps).to.eql(",
                  "    [\"CREATE_ORDER\", \"RESERVE_INVENTORY\", \"PROCESS_PAYMENT\", \"CONFIRM_ORDER\"]));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
