{
	"info": {
		"_postman_id": "8f1e2d3c-4b5a-6789-0123-abcdef456789",
		"name": "Product Service API - Slot 4",
		"description": "Postman Collection for testing Product Service endpoints (CREATE, GET, UPDATE, DELETE, and 404 error cases).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Create Product (POST)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test(\"Response has id and correct fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData.name).to.eql(\"iPhone 15\");",
							"    pm.expect(jsonData.price).to.eql(999.99);",
							"    if (jsonData.id) {",
							"        pm.collectionVariables.set(\"productId\", jsonData.id);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"iPhone 15\",\n  \"description\": \"Apple smartphone\",\n  \"price\": 999.99\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/products",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"products"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Get All Products (GET)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response is an array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"products"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Update Product (PUT)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Product updated correctly\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.name).to.eql(\"iPhone 15 Pro\");",
							"    pm.expect(jsonData.description).to.eql(\"Updated Apple smartphone\");",
							"    pm.expect(jsonData.price).to.eql(1199.99);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"iPhone 15 Pro\",\n  \"description\": \"Updated Apple smartphone\",\n  \"price\": 1199.99\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/products/{{productId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"products",
						"{{productId}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Delete Product (DELETE)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 204 No Content\", function () {",
							"    pm.response.to.have.status(204);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products/{{productId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"products",
						"{{productId}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "5. Update Non-Existent Product (404)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 404 Not Found\", function () {",
							"    pm.response.to.have.status(404);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Non Existing\",\n  \"description\": \"Ghost\",\n  \"price\": 1.00\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/products/non-existent-id-12345",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"products",
						"non-existent-id-12345"
					]
				}
			},
			"response": []
		},
		{
			"name": "6. Delete Non-Existent Product (404)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 404 Not Found\", function () {",
							"    pm.response.to.have.status(404);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products/non-existent-id-12345",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"products",
						"non-existent-id-12345"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "productId",
			"value": "",
			"type": "string"
		}
	]
}
